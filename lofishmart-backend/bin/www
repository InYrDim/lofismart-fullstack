#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require("../app");
var debug = require("debug")("lofish-market:server");
var http = require("http");
var websocket = require("../websocket");
var AppDataSource = require("../config/data-source");

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.BACKEND_PORT || "3000");
app.set("port", port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on("error", onError);
server.on("listening", onListening);

/**
 * Initialize WebSocket server
 */
websocket.init(server);

/**
 * Initialize the database connection BEFORE accepting traffic.
 * Without this, TypeORM connects lazily on the first query, which can
 * surface a slow/stale handshake ("Got timeout reading communication
 * packets") and crash the process. Initializing up front surfaces any
 * DB problem at boot instead of mid-request.
 */
AppDataSource.initialize()
	.then(() => {
		console.log("[info]: ✅ Database connection established");
	})
	.catch((err) => {
		console.error("[error]: ❌ Database connection failed:", err.message);
		process.exit(1);
	});

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
	var port = parseInt(val, 10);

	if (isNaN(port)) {
		// named pipe
		return val;
	}

	if (port >= 0) {
		// port number
		return port;
	}

	return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
	if (error.syscall !== "listen") {
		throw error;
	}

	var bind = typeof port === "string" ? "Pipe " + port : "Port " + port;

	// handle specific listen errors with friendly messages
	switch (error.code) {
		case "EACCES":
			console.error(bind + " requires elevated privileges");
			process.exit(1);
			break;
		case "EADDRINUSE":
			console.error(bind + " is already in use");
			process.exit(1);
			break;
		default:
			throw error;
	}
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
	var addr = server.address();
	var bind = typeof addr === "string" ? "pipe " + addr : "port " + addr.port;
	debug("Listening on " + bind);
}
