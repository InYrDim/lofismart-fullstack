{
  "name": "lofish-market",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "nodemon ./bin/www",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js -d ./config/typeorm-cli.js",
    "typeorm:create": "node --require ts-node/register ./node_modules/typeorm/cli.js",
    "migration": "npm run typeorm migration:run",
    "migration:generate": "npm run typeorm migration:generate -- --outputJs",
    "migration:revert": "npm run typeorm migration:revert",
    "migration:create": "npm run typeorm:create migration:create  -- --outputJs",
    "seeder:create": "npm run typeorm:create migration:create ./db/seeder/$npm_config_name -- --outputJs",
    "seeder:run": "npm run typeorm:create -- migration:run -d ./config/typeorm-seeder-cli.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:single": "jest tests/inventoryController.test.js"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.8.40",
    "bcrypt": "^6.0.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "http-errors": "~1.6.3",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "pug": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/http-errors": "^2.0.5",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.27"
  }
}
